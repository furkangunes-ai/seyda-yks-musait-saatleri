<%- include('partials/head', { title: "Deneme Sınavları - Şeyda" }) %>

<div class="container">
  <header class="page-header">
    <div class="header-row">
      <div>
        <h1>Deneme Sınavları</h1>
        <p class="subtitle">Çözdüğün denemelerin sonuçlarını takip et ve gidişatını grafikle gör.</p>
      </div>
      <div class="nav-buttons">
        <a href="/admin" class="btn btn-secondary">← Ders Programı</a>
        <a href="/admin/backups" class="btn btn-secondary">💾 Yedekler</a>
        <form action="/admin/logout" method="POST" style="display:inline">
          <button type="submit" class="btn btn-secondary">Çıkış</button>
        </form>
      </div>
    </div>
  </header>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <!-- İstatistikler -->
  <div class="stats-bar">
    <div class="stat">
      <span class="stat-number"><%= stats.total %></span>
      <span class="stat-label">Toplam Deneme</span>
    </div>
    <div class="stat">
      <span class="stat-number"><%= stats.lastExamDate ? stats.lastExamDate : '—' %></span>
      <span class="stat-label">Son Deneme</span>
    </div>
  </div>

  <!-- ==========================================
       YENİ DENEME EKLE
       ========================================== -->
  <div class="section-card">
    <h2>Yeni Deneme Ekle</h2>
    <p class="section-desc">Çözdüğün bir denemenin sonucunu kaydet. Net otomatik hesaplanır (Doğru - Yanlış/4).</p>

    <form action="/admin/denemeler/add" method="POST" class="exam-form" id="examForm">
      <div class="form-row">
        <div class="form-group">
          <label>Tarih *</label>
          <input type="date" name="exam_date" required value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div class="form-group">
          <label>Sınav Türü *</label>
          <select name="exam_type" id="examType" required>
            <option value="">-- Seç --</option>
            <option value="TYT">TYT</option>
            <option value="AYT">AYT</option>
          </select>
        </div>
        <div class="form-group">
          <label>Kapsam *</label>
          <select name="scope" id="examScope" required disabled>
            <option value="">-- Önce sınav türü seç --</option>
          </select>
        </div>
        <div class="form-group">
          <label>Ders / Alan *</label>
          <select name="subject" id="examSubject" required disabled>
            <option value="">-- Önce kapsam seç --</option>
          </select>
          <small id="totalInfo" class="total-info"></small>
        </div>
      </div>

      <!-- Tek ders için basit giriş (breakdown olmayanlarda gösterilir) -->
      <div id="simpleInputs">
        <div class="form-row">
          <div class="form-group">
            <label>Doğru</label>
            <input type="number" name="correct" id="correctInput" min="0" placeholder="0">
          </div>
          <div class="form-group">
            <label>Yanlış</label>
            <input type="number" name="wrong" id="wrongInput" min="0" placeholder="0">
          </div>
          <div class="form-group">
            <label>Boş (otomatik)</label>
            <input type="number" name="empty" id="emptyInput" min="0" placeholder="0">
          </div>
          <div class="form-group">
            <label>Net (otomatik)</label>
            <input type="text" id="netDisplay" readonly placeholder="—" class="readonly-input">
          </div>
        </div>
        <div id="validationWarning" class="validation-warning" style="display:none"></div>
      </div>

      <!-- Composite deneme için breakdown (her alt dersi ayrı girme) -->
      <div id="breakdownInputs" style="display:none">
        <div class="breakdown-header">
          <h3>Alt Derslerin Sonuçları</h3>
          <p class="section-desc">Her alt dersin doğru/yanlış/boş sayılarını ayrı ayrı gir. Toplamlar otomatik hesaplanır.</p>
        </div>
        <div id="breakdownContainer"></div>
        <div class="breakdown-totals">
          <div class="total-box">
            <span class="total-label">Toplam Doğru</span>
            <span id="totalCorrect" class="total-value">0</span>
          </div>
          <div class="total-box">
            <span class="total-label">Toplam Yanlış</span>
            <span id="totalWrong" class="total-value">0</span>
          </div>
          <div class="total-box">
            <span class="total-label">Toplam Boş</span>
            <span id="totalEmpty" class="total-value">0</span>
          </div>
          <div class="total-box">
            <span class="total-label">Toplam Net</span>
            <span id="totalNet" class="total-value total-net">0.00</span>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group-full">
          <label>Notlar (opsiyonel)</label>
          <input type="text" name="notes" placeholder="Örn: Limit Yayınları 12. deneme">
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Denemeyi Kaydet</button>
    </form>
  </div>

  <!-- ==========================================
       GRAFİK FİLTRESİ VE GRAFİK
       ========================================== -->
  <div class="section-card">
    <h2>Gidişat Grafiği</h2>
    <p class="section-desc">Aynı türdeki denemelerin zamanla nasıl değiştiğini gör. Aynı kriterde filtreleme yap.</p>

    <form method="GET" action="/admin/denemeler" class="filter-form">
      <select name="exam_type" id="filterType">
        <option value="">Tüm Sınavlar</option>
        <option value="TYT" <%= filter.exam_type === 'TYT' ? 'selected' : '' %>>TYT</option>
        <option value="AYT" <%= filter.exam_type === 'AYT' ? 'selected' : '' %>>AYT</option>
      </select>
      <select name="scope" id="filterScope">
        <option value="">Tüm Kapsamlar</option>
        <option value="Genel" <%= filter.scope === 'Genel' ? 'selected' : '' %>>Genel (Tam Deneme)</option>
        <option value="Alan" <%= filter.scope === 'Alan' ? 'selected' : '' %>>Alan / Branş (Toplu Composite)</option>
        <option value="Tekil Ders" <%= filter.scope === 'Tekil Ders' ? 'selected' : '' %>>Tekil Ders (Her kaynaktan birleşik)</option>
        <option value="Alt Branş" <%= filter.scope === 'Alt Branş' ? 'selected' : '' %>>Alt Ders (Sadece composite içinden)</option>
      </select>
      <select name="subject" id="filterSubject">
        <option value="">Tüm Dersler/Alanlar</option>
      </select>
      <button type="submit" class="btn btn-primary">Filtrele</button>
      <a href="/admin/denemeler" class="btn btn-secondary">Temizle</a>
    </form>

    <% if (filtered && filtered.length > 0) { %>
      <div class="chart-container">
        <canvas id="netChart"></canvas>
      </div>
      <p class="chart-hint">ℹ Aynı günün birden fazla denemesi tek noktada gösterilir (ortalama net). Nokta ne kadar büyükse o gün o kadar çok deneme çözülmüş demektir. Noktanın üzerine gelince o günkü tüm denemeler ayrı ayrı listelenir. Composite deneme (AYT Fen, Sayısal Tam vb.) filtrelendiğinde alt derslerin seyri de aşağıda kesik çizgilerle görünür. 👉 <strong>Bir noktaya tıklarsanız</strong> o günkü denemelerin detayı (ders, net, not) açılır.</p>

      <!-- Seçilen günün detayları buraya render edilir -->
      <div id="dayDetailsPanel" class="day-details-panel hidden"></div>
      <div class="chart-summary">
        <% const nets = filtered.map(f => f.net); %>
        <% const avg = (nets.reduce((a,b) => a+b, 0) / nets.length).toFixed(2); %>
        <% const best = Math.max(...nets).toFixed(2); %>
        <% const worst = Math.min(...nets).toFixed(2); %>
        <div class="summary-item">
          <span class="summary-label">Ortalama Net</span>
          <span class="summary-value"><%= avg %></span>
        </div>
        <div class="summary-item">
          <span class="summary-label">En Yüksek</span>
          <span class="summary-value" style="color:#2e7d32"><%= best %></span>
        </div>
        <div class="summary-item">
          <span class="summary-label">En Düşük</span>
          <span class="summary-value" style="color:#c62828"><%= worst %></span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Deneme Sayısı</span>
          <span class="summary-value"><%= filtered.length %></span>
        </div>
      </div>

      <!-- ==========================================
           GELİŞMİŞ ANALİZ BUTONLARI
           ========================================== -->
      <div class="analysis-section">
        <h3 class="analysis-title">📊 Gelişmiş Analiz</h3>
        <p class="section-desc">Verilerinin üzerinden 20 Haziran YKS için tahmin, detaylı istatistikler ve alt ders dağılımı.</p>

        <div class="analysis-buttons">
          <button type="button" class="analysis-btn" data-target="prediction">🎯 20 Haziran YKS Tahmini</button>
          <button type="button" class="analysis-btn" data-target="stats">📈 Detaylı İstatistikler</button>
          <button type="button" class="analysis-btn" data-target="breakdown">📉 Alt Ders Dağılımı</button>
        </div>

        <div id="analysisPrediction" class="analysis-panel hidden"></div>
        <div id="analysisStats" class="analysis-panel hidden"></div>
        <div id="analysisBreakdown" class="analysis-panel hidden"></div>
      </div>
    <% } else if (filter.exam_type || filter.scope || filter.subject) { %>
      <p class="empty-msg">Bu filtreye uygun deneme bulunamadı.</p>
    <% } else { %>
      <p class="empty-msg">Grafiği görmek için yukarıdan bir filtre seçin.</p>
    <% } %>
  </div>

  <!-- ==========================================
       TÜM DENEMELER LİSTESİ
       ========================================== -->
  <div class="section-card">
    <h2>Tüm Denemeler (<%= exams.length %>)</h2>

    <% if (exams.length > 0) { %>
      <div class="table-wrapper">
        <table class="exams-table">
          <thead>
            <tr>
              <th>Tarih</th>
              <th>Sınav</th>
              <th>Kapsam</th>
              <th>Ders/Alan</th>
              <th>Doğru</th>
              <th>Yanlış</th>
              <th>Boş</th>
              <th>Net</th>
              <th>Not</th>
              <th>Sil</th>
            </tr>
          </thead>
          <tbody>
            <% for (const e of exams) { %>
              <% const isSubRecord = e.scope === 'Alt Branş'; %>
              <tr class="<%= isSubRecord ? 'sub-row' : 'main-row' %>">
                <td><%= e.exam_date %></td>
                <td><span class="exam-badge exam-badge-<%= e.exam_type.toLowerCase() %>"><%= e.exam_type %></span></td>
                <td>
                  <% if (e.scope === 'Genel') { %>
                    <span class="scope-badge scope-genel">Genel</span>
                  <% } else if (e.scope === 'Alan') { %>
                    <span class="scope-badge scope-alan">Alan</span>
                  <% } else if (e.scope === 'Tekil Ders') { %>
                    <span class="scope-badge scope-tekil">Tekil</span>
                  <% } else if (e.scope === 'Alt Branş') { %>
                    <span class="scope-badge scope-alt">Alt Ders</span>
                  <% } else { %>
                    <%= e.scope %>
                  <% } %>
                </td>
                <td><strong><%= isSubRecord ? '↳ ' : '' %><%= e.subject %></strong></td>
                <td><%= e.correct %></td>
                <td><%= e.wrong %></td>
                <td><%= e.empty %></td>
                <td><strong class="net-value"><%= e.net.toFixed(2) %></strong></td>
                <td><small><%= e.notes || '-' %></small></td>
                <td>
                  <form action="/admin/denemeler/delete" method="POST" class="inline-form">
                    <input type="hidden" name="id" value="<%= e.id %>">
                    <button type="submit" class="btn btn-tiny btn-danger" onclick="return confirm('Bu deneme silinsin mi?')">Sil</button>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="empty-msg">Henüz deneme eklenmedi.</p>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Sınav yapısı - hiyerarşik dropdown'lar için
const EXAM_STRUCTURE = <%- JSON.stringify(EXAM_STRUCTURE) %>;

// Subject adından { total, breakdown } detaylarına hızlı erişim
const SUBJECT_DETAILS = {};
for (const type of Object.keys(EXAM_STRUCTURE)) {
  SUBJECT_DETAILS[type] = {};
  for (const scope of Object.keys(EXAM_STRUCTURE[type])) {
    for (const item of EXAM_STRUCTURE[type][scope]) {
      SUBJECT_DETAILS[type][item.name] = item;
    }
  }
}

// Form elementleri
const examType = document.getElementById('examType');
const examScope = document.getElementById('examScope');
const examSubject = document.getElementById('examSubject');
const totalInfo = document.getElementById('totalInfo');
const simpleInputs = document.getElementById('simpleInputs');
const breakdownInputs = document.getElementById('breakdownInputs');
const breakdownContainer = document.getElementById('breakdownContainer');
const correctInput = document.getElementById('correctInput');
const wrongInput = document.getElementById('wrongInput');
const emptyInput = document.getElementById('emptyInput');
const netDisplay = document.getElementById('netDisplay');
const validationWarning = document.getElementById('validationWarning');

examType.addEventListener('change', function() {
  examScope.disabled = !this.value;
  examScope.innerHTML = '<option value="">-- Seç --</option>';
  examSubject.disabled = true;
  examSubject.innerHTML = '<option value="">-- Önce kapsam seç --</option>';
  totalInfo.textContent = '';
  resetInputSection();

  if (this.value && EXAM_STRUCTURE[this.value]) {
    const scopes = Object.keys(EXAM_STRUCTURE[this.value]);
    const scopeLabels = {
      Genel: 'Genel (Tam Deneme)',
      Alan: 'Alan / Branş (Toplu)',
      'Tekil Ders': 'Tekil Ders (Sadece bir ders)'
    };
    for (const s of scopes) {
      const opt = document.createElement('option');
      opt.value = s;
      opt.textContent = scopeLabels[s] || s;
      examScope.appendChild(opt);
    }
  }
});

examScope.addEventListener('change', function() {
  examSubject.disabled = !this.value;
  examSubject.innerHTML = '<option value="">-- Seç --</option>';
  totalInfo.textContent = '';
  resetInputSection();

  const type = examType.value;
  if (type && this.value && EXAM_STRUCTURE[type][this.value]) {
    for (const item of EXAM_STRUCTURE[type][this.value]) {
      const opt = document.createElement('option');
      opt.value = item.name;
      opt.textContent = `${item.name} (${item.total} soru)`;
      examSubject.appendChild(opt);
    }
  }
});

examSubject.addEventListener('change', function() {
  const type = examType.value;
  const item = type && this.value ? SUBJECT_DETAILS[type][this.value] : null;

  if (!item) {
    totalInfo.textContent = '';
    resetInputSection();
    return;
  }

  totalInfo.textContent = `Toplam: ${item.total} soru`;

  if (item.breakdown && item.breakdown.length > 0) {
    // Composite deneme - breakdown inputları göster
    showBreakdownInputs(item);
  } else {
    // Tek ders - basit inputları göster
    showSimpleInputs();
    autoFillEmpty();
    updateNet();
  }
});

function resetInputSection() {
  simpleInputs.style.display = '';
  breakdownInputs.style.display = 'none';
  breakdownContainer.innerHTML = '';
  correctInput.required = true;
  wrongInput.required = true;
  emptyInput.required = true;
}

function showSimpleInputs() {
  simpleInputs.style.display = '';
  breakdownInputs.style.display = 'none';
  breakdownContainer.innerHTML = '';
  correctInput.required = true;
  wrongInput.required = true;
  emptyInput.required = true;
  // Name'leri geri yükle
  correctInput.name = 'correct';
  wrongInput.name = 'wrong';
  emptyInput.name = 'empty';
}

function showBreakdownInputs(item) {
  simpleInputs.style.display = 'none';
  breakdownInputs.style.display = '';
  // Simple input'ları submit'te gönderme
  correctInput.required = false;
  wrongInput.required = false;
  emptyInput.required = false;
  correctInput.name = '';
  wrongInput.name = '';
  emptyInput.name = '';

  // Her alt ders için giriş satırı oluştur
  breakdownContainer.innerHTML = '';
  for (const sub of item.breakdown) {
    const row = document.createElement('div');
    row.className = 'breakdown-row';
    row.innerHTML = `
      <div class="breakdown-label">
        <strong>${sub.name}</strong>
        <small>${sub.total} soru</small>
      </div>
      <div class="breakdown-inputs">
        <input type="number" name="breakdown[${sub.name}][correct]" min="0" max="${sub.total}" placeholder="Doğru" class="bd-correct" data-total="${sub.total}" required>
        <input type="number" name="breakdown[${sub.name}][wrong]" min="0" max="${sub.total}" placeholder="Yanlış" class="bd-wrong" data-total="${sub.total}" required>
        <input type="number" name="breakdown[${sub.name}][empty]" min="0" max="${sub.total}" placeholder="Boş" class="bd-empty" data-total="${sub.total}" required>
        <input type="text" readonly placeholder="Net" class="bd-net readonly-input">
      </div>
    `;
    breakdownContainer.appendChild(row);
  }

  // Breakdown input değişikliklerini dinle
  breakdownContainer.querySelectorAll('input[type="number"]').forEach(inp => {
    inp.addEventListener('input', updateBreakdownRow);
  });
  updateBreakdownTotals();
}

function updateBreakdownRow(e) {
  const row = e.target.closest('.breakdown-row');
  const cEl = row.querySelector('.bd-correct');
  const wEl = row.querySelector('.bd-wrong');
  const eEl = row.querySelector('.bd-empty');
  const nEl = row.querySelector('.bd-net');
  const total = parseInt(cEl.dataset.total);

  const c = parseInt(cEl.value) || 0;
  const w = parseInt(wEl.value) || 0;

  // Boş'u otomatik doldur (eğer empty input değişikliği değilse)
  if (e.target !== eEl) {
    const remaining = total - c - w;
    if (remaining >= 0) eEl.value = remaining;
  }

  const net = Math.max(0, c - w / 4);
  nEl.value = net.toFixed(2);

  updateBreakdownTotals();
}

function updateBreakdownTotals() {
  let tc = 0, tw = 0, te = 0, tn = 0;
  breakdownContainer.querySelectorAll('.breakdown-row').forEach(row => {
    const c = parseInt(row.querySelector('.bd-correct').value) || 0;
    const w = parseInt(row.querySelector('.bd-wrong').value) || 0;
    const e = parseInt(row.querySelector('.bd-empty').value) || 0;
    tc += c; tw += w; te += e;
    tn += Math.max(0, c - w / 4);
  });
  document.getElementById('totalCorrect').textContent = tc;
  document.getElementById('totalWrong').textContent = tw;
  document.getElementById('totalEmpty').textContent = te;
  document.getElementById('totalNet').textContent = tn.toFixed(2);
}

// Tek ders için: Boş'u otomatik hesapla
function autoFillEmpty() {
  const type = examType.value;
  const subject = examSubject.value;
  if (!type || !subject || !SUBJECT_DETAILS[type] || !SUBJECT_DETAILS[type][subject]) return;
  const total = SUBJECT_DETAILS[type][subject].total;
  const c = parseInt(correctInput.value) || 0;
  const w = parseInt(wrongInput.value) || 0;
  const remaining = total - c - w;
  if (remaining >= 0) {
    emptyInput.value = remaining;
  }
}

// Tek ders: Net hesaplama + doğrulama
function updateNet() {
  const c = parseInt(correctInput.value) || 0;
  const w = parseInt(wrongInput.value) || 0;
  const e = parseInt(emptyInput.value) || 0;
  const net = Math.max(0, c - w / 4);
  netDisplay.value = net.toFixed(2);

  const type = examType.value;
  const subject = examSubject.value;
  if (type && subject && SUBJECT_DETAILS[type] && SUBJECT_DETAILS[type][subject]) {
    const total = SUBJECT_DETAILS[type][subject].total;
    const sum = c + w + e;
    if (sum > total) {
      validationWarning.style.display = 'block';
      validationWarning.className = 'validation-warning';
      validationWarning.textContent = `⚠ Doğru + yanlış + boş (${sum}) toplam sorudan (${total}) fazla olamaz.`;
    } else if (sum < total && (c > 0 || w > 0 || e > 0)) {
      validationWarning.style.display = 'block';
      validationWarning.className = 'validation-warning validation-info';
      validationWarning.textContent = `ℹ ${total - sum} soru eksik. Toplam ${total} olmalı.`;
    } else {
      validationWarning.style.display = 'none';
    }
  }
}

correctInput.addEventListener('input', () => { autoFillEmpty(); updateNet(); });
wrongInput.addEventListener('input', () => { autoFillEmpty(); updateNet(); });
emptyInput.addEventListener('input', updateNet);

// Filtre için cascading dropdown
const filterType = document.getElementById('filterType');
const filterScope = document.getElementById('filterScope');
const filterSubject = document.getElementById('filterSubject');
const currentFilterSubject = <%- JSON.stringify(filter.subject) %>;

function updateFilterSubjects() {
  const type = filterType.value;
  const scope = filterScope.value;
  filterSubject.innerHTML = '<option value="">Tüm Dersler/Alanlar</option>';

  const options = new Set();

  if (type && EXAM_STRUCTURE[type]) {
    // 'Tekil Ders' seçildiyse: hem Tekil Ders listesindeki dersler
    // hem de composite breakdown'larda geçen tüm alt dersler.
    // Böylece "Tekil Ders + Fizik" seçimi, AYT Fen veya Sayısal Tam
    // içinden gelen Fizik kayıtlarını da kapsar.
    if (scope === 'Tekil Ders') {
      if (EXAM_STRUCTURE[type]['Tekil Ders']) {
        for (const item of EXAM_STRUCTURE[type]['Tekil Ders']) {
          options.add(item.name);
        }
      }
      for (const s of Object.keys(EXAM_STRUCTURE[type])) {
        for (const item of EXAM_STRUCTURE[type][s]) {
          if (item.breakdown) {
            for (const sub of item.breakdown) options.add(sub.name);
          }
        }
      }
    }
    // Alt Branş seçildiyse: sadece composite içinden gelen alt dersler
    else if (scope === 'Alt Branş') {
      for (const s of Object.keys(EXAM_STRUCTURE[type])) {
        for (const item of EXAM_STRUCTURE[type][s]) {
          if (item.breakdown) {
            for (const sub of item.breakdown) options.add(sub.name);
          }
        }
      }
    }
    // Genel veya Alan seçildiyse: ana kategorileri göster
    else if (scope && EXAM_STRUCTURE[type][scope]) {
      for (const item of EXAM_STRUCTURE[type][scope]) {
        options.add(item.name);
      }
    }
    // Scope seçilmediyse: her şeyi göster
    else {
      for (const s of Object.keys(EXAM_STRUCTURE[type])) {
        for (const item of EXAM_STRUCTURE[type][s]) {
          options.add(item.name);
          if (item.breakdown) {
            for (const sub of item.breakdown) options.add(sub.name);
          }
        }
      }
    }
  }

  for (const sub of options) {
    const opt = document.createElement('option');
    opt.value = sub;
    opt.textContent = sub;
    if (sub === currentFilterSubject) opt.selected = true;
    filterSubject.appendChild(opt);
  }
}
filterType.addEventListener('change', updateFilterSubjects);
filterScope.addEventListener('change', updateFilterSubjects);
updateFilterSubjects();

// ==========================================
// GRAFİK + GELİŞMİŞ ANALİZ
// ==========================================
<% if (filtered && filtered.length > 0) { %>
  // --- Ortak sabitler ---
  const YKS_DATE = new Date('2026-06-20');
  const ALL_EXAMS = <%- JSON.stringify(exams) %>;
  const CURRENT_FILTER = <%- JSON.stringify(filter) %>;
  const FILTERED_RAW = <%- JSON.stringify(filtered.map(f => ({ id: f.id, exam_date: f.exam_date, exam_type: f.exam_type, scope: f.scope, subject: f.subject, net: f.net, correct: f.correct, wrong: f.wrong, empty: f.empty, parent_id: f.parent_id }))) %>;

  // Ders renkleri
  const SUBJECT_COLORS = {
    'Fizik': '#4361ee',
    'Kimya': '#06a77d',
    'Biyoloji': '#e63946',
    'Matematik': '#f77f00',
    'Geometri': '#8338ec',
    'Türkçe': '#9d4edd',
    'Tarih': '#e76f51',
    'Coğrafya': '#2a9d8f',
    'Felsefe': '#e9c46a',
    'Din Kültürü': '#f4a261',
    'Sosyal Bilimler': '#264653',
    'Fen Bilimleri': '#1d3557',
    'Tarih-1': '#e76f51',
    'Coğrafya-1': '#2a9d8f'
  };
  function getColor(name, idx) {
    return SUBJECT_COLORS[name] || `hsl(${(idx * 47) % 360}, 65%, 55%)`;
  }

  // Filtreye göre breakdown alt derslerini (Fizik/Kimya/Biyoloji gibi) döner
  function getBreakdownSubjects(examType, subjectName) {
    if (!examType || !subjectName) return [];
    const struct = EXAM_STRUCTURE[examType];
    if (!struct) return [];
    for (const scope of Object.keys(struct)) {
      for (const item of struct[scope]) {
        if (item.name === subjectName && item.breakdown) {
          return item.breakdown.map(b => b.name);
        }
      }
    }
    return [];
  }

  // Bir parent kaydının alt ders (Alt Branş) çocuklarını döner.
  // Önce parent_id ile kesin eşleşme; yoksa eski kayıtlar için tarih/tür/ders
  // fallback'i (diğer parent'a bağlı olmayan çocuklar).
  function getChildrenForParent(parent) {
    const direct = ALL_EXAMS.filter(e =>
      e.parent_id === parent.id && e.scope === 'Alt Branş'
    );
    if (direct.length > 0) return direct;

    // Fallback (geçmiş veriler için)
    const bdSubjects = getBreakdownSubjects(parent.exam_type, parent.subject);
    if (bdSubjects.length === 0) return [];
    const linkedChildIds = new Set(
      ALL_EXAMS.filter(e => e.parent_id != null).map(e => e.id)
    );
    return ALL_EXAMS.filter(e =>
      e.exam_date === parent.exam_date &&
      e.exam_type === parent.exam_type &&
      e.scope === 'Alt Branş' &&
      bdSubjects.includes(e.subject) &&
      !linkedChildIds.has(e.id)
    );
  }

  // ==========================================
  // GİDİŞAT GRAFİĞİ (Ana)
  // ==========================================
  const rawData = FILTERED_RAW.map(f => ({
    date: f.exam_date, net: f.net, subject: f.subject,
    notes: ALL_EXAMS.find(e => e.id === f.id)?.notes || ''
  }));

  // Güne göre grupla
  const byDate = {};
  for (const item of rawData) {
    if (!byDate[item.date]) byDate[item.date] = [];
    byDate[item.date].push(item);
  }
  const dates = Object.keys(byDate).sort();
  const chartData = dates.map(date => {
    const items = byDate[date];
    const avg = items.reduce((s, i) => s + i.net, 0) / items.length;
    return { date, avgNet: parseFloat(avg.toFixed(2)), count: items.length, items };
  });
  const pointSizes = chartData.map(d => Math.min(16, 5 + (d.count - 1) * 3));

  // Composite filter mi? → Alt ders çizgilerini oluştur
  const breakdownSubjects = (CURRENT_FILTER.scope === 'Alan' || CURRENT_FILTER.scope === 'Genel')
    ? getBreakdownSubjects(CURRENT_FILTER.exam_type, CURRENT_FILTER.subject)
    : [];

  // Sadece filtredeki composite parent'ların alt derslerini topla
  // (başka composite'in alt dersleri dahil olmamalı)
  const filteredChildren = [];
  for (const p of FILTERED_RAW) {
    if (p.scope === 'Alan' || p.scope === 'Genel') {
      filteredChildren.push(...getChildrenForParent(p));
    }
  }

  // Her alt ders için tarihlere göre ortalama net
  const subLineData = {};
  for (const subName of breakdownSubjects) {
    subLineData[subName] = dates.map(date => {
      const matches = filteredChildren.filter(e =>
        e.exam_date === date &&
        e.subject === subName
      );
      if (matches.length === 0) return null;
      return parseFloat((matches.reduce((s, m) => s + m.net, 0) / matches.length).toFixed(2));
    });
  }

  // Datasets oluştur: ana toplam + alt ders çizgileri
  const datasets = [{
    label: CURRENT_FILTER.subject ? `${CURRENT_FILTER.subject} (Toplam)` : 'Toplam Net',
    data: chartData.map(d => d.avgNet),
    borderColor: '#4361ee',
    backgroundColor: 'rgba(67, 97, 238, 0.1)',
    borderWidth: 2.5,
    fill: breakdownSubjects.length === 0,
    tension: 0.2,
    pointRadius: pointSizes,
    pointHoverRadius: pointSizes.map(r => r + 3),
    pointBackgroundColor: '#4361ee',
    pointBorderColor: '#fff',
    pointBorderWidth: 2,
    order: 1
  }];

  let colorIdx = 0;
  for (const subName of breakdownSubjects) {
    const color = getColor(subName, colorIdx++);
    datasets.push({
      label: subName,
      data: subLineData[subName],
      borderColor: color,
      backgroundColor: color + '22',
      borderWidth: 1.8,
      borderDash: [6, 3],
      fill: false,
      tension: 0.25,
      pointRadius: 4,
      pointHoverRadius: 6,
      pointBackgroundColor: color,
      pointBorderColor: '#fff',
      pointBorderWidth: 1.5,
      spanGaps: true,
      order: 2
    });
  }

  const ctx = document.getElementById('netChart').getContext('2d');
  const netChart = new Chart(ctx, {
    type: 'line',
    data: { labels: dates, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      onHover: (event, els) => {
        event.native.target.style.cursor = els.length ? 'pointer' : 'default';
      },
      onClick: (event, els) => {
        if (els.length === 0) return;
        const idx = els[0].index;
        if (idx != null && dates[idx]) showDayDetails(dates[idx]);
      },
      plugins: {
        legend: {
          display: breakdownSubjects.length > 0,
          position: 'bottom',
          labels: { usePointStyle: true, padding: 12, font: { size: 11 } }
        },
        tooltip: {
          callbacks: {
            title: function(ctx) {
              const d = chartData[ctx[0].dataIndex];
              return d.date + (d.count > 1 ? ` — ${d.count} deneme` : '');
            },
            label: function(ctx) {
              if (ctx.datasetIndex === 0) {
                const d = chartData[ctx.dataIndex];
                return (d.count > 1 ? 'Toplam (Günlük Ort): ' : 'Toplam: ') + d.avgNet;
              }
              if (ctx.parsed.y === null) return null;
              return `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)}`;
            },
            afterLabel: function(ctx) {
              if (ctx.datasetIndex !== 0) return null;
              const d = chartData[ctx.dataIndex];
              if (d.count > 1) {
                return d.items.map((i, idx) =>
                  `  ${idx + 1}. ${i.net.toFixed(2)} — ${i.subject}${i.notes ? ` (${i.notes})` : ''}`
                );
              }
              const it = d.items[0];
              return `  ${it.subject}${it.notes ? ` (${it.notes})` : ''}`;
            },
            footer: function() {
              return '\n👆 Detaylar için tıklayın';
            }
          }
        }
      },
      scales: {
        y: { beginAtZero: true, title: { display: true, text: 'Net' } },
        x: { title: { display: true, text: 'Tarih' } }
      }
    }
  });

  // ---------- Seçilen Günün Detaylarını Göster ----------
  function scopeBadgeClass(scope) {
    if (scope === 'Genel') return 'scope-genel';
    if (scope === 'Alan') return 'scope-alan';
    if (scope === 'Tekil Ders') return 'scope-tekil';
    if (scope === 'Alt Branş') return 'scope-alt';
    return '';
  }

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]);
  }

  function showDayDetails(date) {
    const panel = document.getElementById('dayDetailsPanel');

    // Bu tarihte filtrelenmiş tüm kayıtları al (ana kayıtlar)
    const dayRecords = FILTERED_RAW.filter(f => f.exam_date === date);
    if (dayRecords.length === 0) {
      panel.classList.add('hidden');
      return;
    }

    let html = `
      <div class="analysis-card day-details-card">
        <div class="day-details-header">
          <h4>📅 ${date} — ${dayRecords.length} Deneme</h4>
          <button class="day-close-btn" onclick="document.getElementById('dayDetailsPanel').classList.add('hidden')" title="Kapat">✕</button>
        </div>`;

    dayRecords.forEach((rec, idx) => {
      const full = ALL_EXAMS.find(e => e.id === rec.id) || rec;
      const badgeCls = scopeBadgeClass(rec.scope);

      // Bu composite parent ise alt ders kayıtlarını bul
      // parent_id bazlı kesin eşleşme kullanılır
      let breakdownSubs = [];
      if (rec.scope === 'Alan' || rec.scope === 'Genel') {
        breakdownSubs = getChildrenForParent(rec);
      }

      const maxN = getMaxNet(rec.exam_type, rec.subject);
      const totalHint = maxN ? ` / ${maxN}` : '';

      html += `
        <div class="deneme-detail-card">
          <div class="dd-header">
            <span class="exam-badge exam-badge-${rec.exam_type.toLowerCase()}">${rec.exam_type}</span>
            <strong class="dd-subject">${escapeHtml(rec.subject)}</strong>
            <span class="scope-badge ${badgeCls}">${rec.scope}</span>
            ${full.notes ? `<span class="dd-notes">📝 ${escapeHtml(full.notes)}</span>` : ''}
          </div>
          <div class="dd-totals">
            <span class="dd-stat"><span class="dd-lbl">Doğru</span><strong class="dd-val dd-correct">${rec.correct}</strong></span>
            <span class="dd-stat"><span class="dd-lbl">Yanlış</span><strong class="dd-val dd-wrong">${rec.wrong}</strong></span>
            <span class="dd-stat"><span class="dd-lbl">Boş</span><strong class="dd-val">${rec.empty}</strong></span>
            <span class="dd-stat dd-net-box"><span class="dd-lbl">Net</span><strong class="dd-val dd-net">${rec.net.toFixed(2)}${totalHint}</strong></span>
          </div>`;

      if (breakdownSubs.length > 0) {
        html += `
          <div class="dd-breakdown-wrap">
            <h5 class="dd-breakdown-title">Alt Ders Dağılımı:</h5>
            <table class="dd-breakdown">
              <thead>
                <tr>
                  <th>Ders</th>
                  <th>Doğru</th>
                  <th>Yanlış</th>
                  <th>Boş</th>
                  <th>Net</th>
                </tr>
              </thead>
              <tbody>`;
        breakdownSubs.forEach((sub, si) => {
          const color = getColor(sub.subject, si);
          html += `
            <tr>
              <td><span class="dd-subj-dot" style="background:${color}"></span>${escapeHtml(sub.subject)}</td>
              <td>${sub.correct}</td>
              <td>${sub.wrong}</td>
              <td>${sub.empty}</td>
              <td><strong class="dd-net">${sub.net.toFixed(2)}</strong></td>
            </tr>`;
        });
        html += `
              </tbody>
            </table>
          </div>`;
      }
      html += `</div>`;
    });

    html += `</div>`;
    panel.innerHTML = html;
    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ---------- Linear Regresyon ----------
  function linearRegression(points) {
    const n = points.length;
    if (n < 2) return null;
    const sumX = points.reduce((s, p) => s + p.x, 0);
    const sumY = points.reduce((s, p) => s + p.y, 0);
    const sumXY = points.reduce((s, p) => s + p.x * p.y, 0);
    const sumX2 = points.reduce((s, p) => s + p.x * p.x, 0);
    const meanX = sumX / n, meanY = sumY / n;
    const denom = n * sumX2 - sumX * sumX;
    if (denom === 0) return null;
    const slope = (n * sumXY - sumX * sumY) / denom;
    const intercept = (sumY - slope * sumX) / n;
    const ssTotal = points.reduce((s, p) => s + Math.pow(p.y - meanY, 2), 0);
    const ssResidual = points.reduce((s, p) => s + Math.pow(p.y - (slope * p.x + intercept), 2), 0);
    const r2 = ssTotal === 0 ? 1 : 1 - (ssResidual / ssTotal);
    const se = n > 2 ? Math.sqrt(ssResidual / (n - 2)) : 0;
    return { slope, intercept, r2, se, n, meanX };
  }

  // ---------- Max Net Lookup ----------
  // Filtreye göre o dersin maksimum yapılabilecek net sayısını döner
  // (AYT Fizik = 14, TYT Fizik = 7, AYT Fen = 40 vb.)
  function getMaxNet(examType, subject) {
    if (!examType || !subject) return null;
    const struct = EXAM_STRUCTURE[examType];
    if (!struct) return null;
    for (const scope of Object.keys(struct)) {
      for (const item of struct[scope]) {
        if (item.name === subject) return item.total;
        if (item.breakdown) {
          const sub = item.breakdown.find(b => b.name === subject);
          if (sub) return sub.total;
        }
      }
    }
    return null;
  }

  // ---------- Lojistik (Sigmoid) Regresyon ----------
  // Net değerini [0, maxNet] aralığına sıkıştırıp logit dönüşümü uygulayarak
  // linear regresyon yapar. Tahmin doğal olarak sınırlar içinde kalır.
  // y → p = y/maxNet → logit(p) → regression → back-transform
  function logisticRegression(points, maxNet) {
    if (!maxNet || points.length < 2) return null;
    const eps = 0.001;
    const transformed = points.map(p => {
      const ratio = Math.max(eps, Math.min(1 - eps, p.y / maxNet));
      return { x: p.x, y: Math.log(ratio / (1 - ratio)) };
    });
    // Değişim yok mu? (yatay çizgi) → lojistik anlamsız
    const yVals = transformed.map(p => p.y);
    if (Math.max(...yVals) - Math.min(...yVals) < 0.001) return null;

    const linReg = linearRegression(transformed);
    if (!linReg) return null;

    return {
      slope: linReg.slope,
      intercept: linReg.intercept,
      r2: linReg.r2,
      se: linReg.se,
      n: linReg.n,
      maxNet,
      predict: function(x) {
        const logit = linReg.slope * x + linReg.intercept;
        return maxNet / (1 + Math.exp(-logit));
      },
      predictInterval: function(x, z = 1.96) {
        const logitPred = linReg.slope * x + linReg.intercept;
        const low = logitPred - z * linReg.se;
        const high = logitPred + z * linReg.se;
        return {
          low: maxNet / (1 + Math.exp(-low)),
          high: maxNet / (1 + Math.exp(-high))
        };
      }
    };
  }

  // Günlük verileri regresyon için hazırla (baseDate'den gün sayısı = x, net = y)
  function prepareRegressionPoints(items, baseDate) {
    return items.map(it => ({
      x: Math.round((new Date(it.exam_date) - baseDate) / (1000 * 60 * 60 * 24)),
      y: it.net
    }));
  }

  function daysBetween(d1, d2) {
    return Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));
  }

  // ---------- Tahmin Paneli ----------
  function renderPrediction() {
    const panel = document.getElementById('analysisPrediction');
    if (FILTERED_RAW.length < 2) {
      panel.innerHTML = `<div class="analysis-card"><p class="empty-msg">Tahmin için en az 2 deneme gerekli. Şu an ${FILTERED_RAW.length} deneme var.</p></div>`;
      return;
    }

    const sortedData = [...FILTERED_RAW].sort((a, b) => new Date(a.exam_date) - new Date(b.exam_date));
    const baseDate = new Date(sortedData[0].exam_date);
    const points = prepareRegressionPoints(sortedData, baseDate);
    const linReg = linearRegression(points);

    if (!linReg) {
      panel.innerHTML = `<div class="analysis-card"><p class="empty-msg">Tahmin hesaplanamadı (tarihler çok yakın veya sabit).</p></div>`;
      return;
    }

    // Max net belirle
    const maxNet = getMaxNet(CURRENT_FILTER.exam_type, CURRENT_FILTER.subject);
    const logReg = maxNet ? logisticRegression(points, maxNet) : null;

    const daysToYks = daysBetween(baseDate, YKS_DATE);
    const today = new Date();
    const daysUntilExam = Math.max(0, daysBetween(today, YKS_DATE));

    // === BİRİNCİL TAHMİN (Lojistik eğer max biliniyorsa, yoksa clamped linear) ===
    let primaryValue, primaryLow, primaryHigh, primaryLabel, primaryNote;

    if (logReg) {
      primaryValue = logReg.predict(daysToYks);
      const ci = logReg.predictInterval(daysToYks);
      primaryLow = ci.low;
      primaryHigh = ci.high;
      primaryLabel = '🎯 Gerçekçi Tahmin (Lojistik / Sigmoid)';
      primaryNote = `Değer doğal olarak [0, ${maxNet}] aralığında kalır - maksimuma yaklaştıkça büyüme yavaşlar.`;
    } else if (maxNet) {
      const rawPred = linReg.slope * daysToYks + linReg.intercept;
      primaryValue = Math.max(0, Math.min(maxNet, rawPred));
      primaryLow = Math.max(0, rawPred - 1.96 * linReg.se);
      primaryHigh = Math.min(maxNet, rawPred + 1.96 * linReg.se);
      primaryLabel = '🎯 Sınırlandırılmış Linear Tahmin';
      primaryNote = `Lojistik uygulanamadı; linear sonucu [0, ${maxNet}] aralığına kısaltıldı.`;
    } else {
      const rawPred = linReg.slope * daysToYks + linReg.intercept;
      primaryValue = Math.max(0, rawPred);
      primaryLow = Math.max(0, rawPred - 1.96 * linReg.se);
      primaryHigh = rawPred + 1.96 * linReg.se;
      primaryLabel = '🎯 Linear Regresyon Tahmini';
      primaryNote = 'Bir ders filtrelenirse (örn: AYT Fizik) maksimum limit uygulanır.';
    }

    // === HAM LINEAR (referans için) ===
    const rawLinear = linReg.slope * daysToYks + linReg.intercept;
    const linearCapped = maxNet && (rawLinear > maxNet || rawLinear < 0);
    const rawLinearDisplay = linearCapped
      ? `<em>${rawLinear.toFixed(2)} net</em> <span class="cap-badge">⚠ Fiziksel limit (${maxNet}) aşıldı</span>`
      : `${rawLinear.toFixed(2)} net`;

    // Moving averages
    const nets = sortedData.map(d => d.net);
    const ma5 = nets.length >= 5 ? (nets.slice(-5).reduce((s, n) => s + n, 0) / 5).toFixed(2) : null;
    const ma10 = nets.length >= 10 ? (nets.slice(-10).reduce((s, n) => s + n, 0) / 10).toFixed(2) : null;

    // Exponential smoothing + clamp
    let expSmooth = nets[0];
    for (let i = 1; i < nets.length; i++) expSmooth = 0.3 * nets[i] + 0.7 * expSmooth;
    const expClamped = maxNet ? Math.max(0, Math.min(maxNet, expSmooth)) : Math.max(0, expSmooth);

    // Hız yorumu (lojistik için: birincil ile bugünkü tahmin arası ortalama günlük değişim)
    let dailyRate, dailyRateText;
    if (logReg && daysUntilExam > 0) {
      const daysFromStartToToday = daysBetween(baseDate, today);
      const todayPred = logReg.predict(Math.max(0, daysFromStartToToday));
      dailyRate = daysUntilExam > 0 ? (primaryValue - todayPred) / daysUntilExam : 0;
      dailyRateText = `${dailyRate >= 0 ? '+' : ''}${dailyRate.toFixed(3)} net/gün (bu tempo korunursa)`;
    } else {
      dailyRate = linReg.slope;
      dailyRateText = `${dailyRate >= 0 ? '+' : ''}${dailyRate.toFixed(3)} net/gün`;
    }
    const trendColor = dailyRate >= 0 ? '#2e7d32' : '#c62828';

    // R² kalite etiketi
    let qualityLabel = 'Düşük güven', qualityColor = '#c62828';
    if (linReg.r2 >= 0.7) { qualityLabel = 'Yüksek güven'; qualityColor = '#2e7d32'; }
    else if (linReg.r2 >= 0.4) { qualityLabel = 'Orta güven'; qualityColor = '#f77f00'; }

    const maxInfoHTML = maxNet
      ? `<div class="max-info">
           <strong>📏 Maksimum Net Limiti:</strong> ${maxNet}
           <small>${CURRENT_FILTER.exam_type} ${CURRENT_FILTER.subject}</small>
         </div>`
      : `<div class="max-info max-info-unknown">
           <strong>⚠ Max limit belirlenemedi.</strong>
           <small>Lojistik model için <em>sınav türü + ders</em> filtrelenmeli.</small>
         </div>`;

    panel.innerHTML = `
      <div class="analysis-card prediction-card">
        <div class="pred-header">
          <h4>🎯 20 Haziran 2026 (YKS) Tahmini</h4>
          <span class="days-left">Sınava <strong>${daysUntilExam}</strong> gün kaldı</span>
        </div>

        ${maxInfoHTML}

        <div class="pred-main">
          <div class="pred-primary">
            <span class="pred-label">${primaryLabel}</span>
            <span class="pred-value">${primaryValue.toFixed(2)} net${maxNet ? ' / ' + maxNet : ''}</span>
            <span class="pred-range">Olası aralık: <strong>${primaryLow.toFixed(2)} — ${primaryHigh.toFixed(2)}</strong></span>
            <span class="pred-quality" style="background:${qualityColor}">R² = ${linReg.r2.toFixed(3)} · ${qualityLabel}</span>
            <p class="pred-note">${primaryNote}</p>
          </div>
        </div>

        ${maxNet ? `
        <div class="pred-secondary">
          <span class="pred-sec-label">📏 Ham Linear Regresyon (Sınırsız, referans):</span>
          <span class="pred-sec-value">${rawLinearDisplay}</span>
          <small>Linear regresyon düz çizgisel bir projeksiyon yapar — tempoyu koruma varsayımı. Fiziksel max aşılırsa
          bu sayı <strong>olası değil</strong>, gerçekçi tahmin için yukarıdaki lojistik değeri kullanın.</small>
        </div>` : ''}

        <div class="pred-details">
          <div class="pred-detail-item">
            <span class="pd-label">Günlük değişim hızı</span>
            <span class="pd-value" style="color:${trendColor}">${dailyRateText}</span>
          </div>
          ${ma5 ? `<div class="pred-detail-item"><span class="pd-label">Son 5 Deneme Ortalaması</span><span class="pd-value">${ma5} net</span></div>` : ''}
          ${ma10 ? `<div class="pred-detail-item"><span class="pd-label">Son 10 Deneme Ortalaması</span><span class="pd-value">${ma10} net</span></div>` : ''}
          <div class="pred-detail-item">
            <span class="pd-label">Üstel Düzeltilmiş Tahmin</span>
            <span class="pd-value">${expClamped.toFixed(2)} net</span>
          </div>
          <div class="pred-detail-item">
            <span class="pd-label">Kullanılan veri sayısı</span>
            <span class="pd-value">${linReg.n} deneme</span>
          </div>
        </div>

        <div class="analysis-disclaimer">
          <strong>ℹ Modeller nasıl çalışır?</strong>
          <br>• <strong>Lojistik (Sigmoid):</strong> Net değerinin matematiksel olarak imkansız sınırları (0 ve max) aşmasına izin vermez. Maksimuma yaklaştıkça doğal olarak yavaşlar, öğrenme eğrilerine daha uygun.
          <br>• <strong>Linear:</strong> Düz bir çizgi uzatır, sınır gözetmez. Referans için yararlıdır ama fiziksel limiti aşabilir.
          <br>• <strong>R²:</strong> Veriye uyum skoru (0-1). 1'e yakın = yüksek güvenilirlik.
          ${linReg.n < 5 ? '<br><strong>⚠</strong> <5 deneme ile güvenilirlik sınırlı; daha çok deneme ekledikçe tahmin netleşir.' : ''}
        </div>
      </div>
    `;
  }

  // ---------- Detaylı İstatistikler ----------
  function renderStats() {
    const panel = document.getElementById('analysisStats');
    if (FILTERED_RAW.length === 0) {
      panel.innerHTML = `<div class="analysis-card"><p class="empty-msg">Veri yok.</p></div>`;
      return;
    }

    const sortedData = [...FILTERED_RAW].sort((a, b) => new Date(a.exam_date) - new Date(b.exam_date));
    const nets = sortedData.map(d => d.net);
    const n = nets.length;
    const mean = nets.reduce((s, v) => s + v, 0) / n;
    const variance = nets.reduce((s, v) => s + Math.pow(v - mean, 2), 0) / n;
    const stdDev = Math.sqrt(variance);

    const today = new Date();
    const firstDate = new Date(sortedData[0].exam_date);
    const lastDate = new Date(sortedData[sortedData.length - 1].exam_date);
    const daysTracking = daysBetween(firstDate, today);
    const daysUntilExam = Math.max(0, daysBetween(today, YKS_DATE));

    // Toplam doğru/yanlış/boş (trend gözlemi için)
    const totalC = sortedData.reduce((s, d) => s + d.correct, 0);
    const totalW = sortedData.reduce((s, d) => s + d.wrong, 0);
    const totalE = sortedData.reduce((s, d) => s + d.empty, 0);

    // Son 30 gün vs önceki dönem karşılaştırma
    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
    const recent = sortedData.filter(d => new Date(d.exam_date) >= thirtyDaysAgo);
    const older = sortedData.filter(d => new Date(d.exam_date) < thirtyDaysAgo);
    const recentAvg = recent.length > 0 ? recent.reduce((s, d) => s + d.net, 0) / recent.length : null;
    const olderAvg = older.length > 0 ? older.reduce((s, d) => s + d.net, 0) / older.length : null;

    // Uniq günler
    const uniqDates = new Set(sortedData.map(d => d.exam_date)).size;

    // En iyi ve en kötü deneme
    const best = sortedData.reduce((a, b) => a.net > b.net ? a : b);
    const worst = sortedData.reduce((a, b) => a.net < b.net ? a : b);

    // Ortalama deneme sıklığı (kaç günde bir)
    const avgFrequency = uniqDates > 1 ? (daysBetween(firstDate, lastDate) / (uniqDates - 1)).toFixed(1) : '-';

    let trendText = 'Yeterli veri yok';
    let trendColor = '#888';
    if (recentAvg !== null && olderAvg !== null) {
      const diff = recentAvg - olderAvg;
      const pct = olderAvg > 0 ? (diff / olderAvg * 100) : 0;
      trendText = `${diff >= 0 ? '+' : ''}${diff.toFixed(2)} (${pct >= 0 ? '+' : ''}${pct.toFixed(1)}%)`;
      trendColor = diff >= 0 ? '#2e7d32' : '#c62828';
    }

    panel.innerHTML = `
      <div class="analysis-card">
        <h4>📈 Detaylı İstatistikler</h4>
        <div class="stats-grid">
          <div class="stat-block">
            <span class="sb-label">Toplam Deneme</span>
            <span class="sb-value">${n}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Deneme Yapılan Gün</span>
            <span class="sb-value">${uniqDates}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Sınava Kalan</span>
            <span class="sb-value" style="color:#d62828">${daysUntilExam} gün</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Takip Süresi</span>
            <span class="sb-value">${Math.max(0, daysTracking)} gün</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Ortalama Net</span>
            <span class="sb-value">${mean.toFixed(2)}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Standart Sapma</span>
            <span class="sb-value">${stdDev.toFixed(2)}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Ort. Deneme Sıklığı</span>
            <span class="sb-value">${avgFrequency} günde 1</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Toplam Doğru</span>
            <span class="sb-value" style="color:#2e7d32">${totalC}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Toplam Yanlış</span>
            <span class="sb-value" style="color:#c62828">${totalW}</span>
          </div>
          <div class="stat-block">
            <span class="sb-label">Toplam Boş</span>
            <span class="sb-value" style="color:#888">${totalE}</span>
          </div>
        </div>

        <div class="stats-compare">
          <h5>Son 30 Gün vs Önceki Dönem</h5>
          <div class="compare-grid">
            <div class="cmp-block">
              <span class="cmp-label">Son 30 gün ortalama</span>
              <span class="cmp-value">${recentAvg !== null ? recentAvg.toFixed(2) : '-'} net</span>
              <span class="cmp-sub">(${recent.length} deneme)</span>
            </div>
            <div class="cmp-block">
              <span class="cmp-label">Önceki dönem ortalama</span>
              <span class="cmp-value">${olderAvg !== null ? olderAvg.toFixed(2) : '-'} net</span>
              <span class="cmp-sub">(${older.length} deneme)</span>
            </div>
            <div class="cmp-block">
              <span class="cmp-label">Değişim</span>
              <span class="cmp-value" style="color:${trendColor}">${trendText}</span>
            </div>
          </div>
        </div>

        <div class="stats-highlights">
          <div class="highlight-row">
            <span class="hl-icon">🏆</span>
            <span class="hl-label">En İyi Deneme:</span>
            <span class="hl-value">${best.net.toFixed(2)} net</span>
            <span class="hl-meta">${best.exam_date} · ${best.subject}</span>
          </div>
          <div class="highlight-row">
            <span class="hl-icon">📉</span>
            <span class="hl-label">En Düşük:</span>
            <span class="hl-value">${worst.net.toFixed(2)} net</span>
            <span class="hl-meta">${worst.exam_date} · ${worst.subject}</span>
          </div>
          <div class="highlight-row">
            <span class="hl-icon">📅</span>
            <span class="hl-label">İlk Deneme:</span>
            <span class="hl-value">${sortedData[0].exam_date}</span>
          </div>
          <div class="highlight-row">
            <span class="hl-icon">⏰</span>
            <span class="hl-label">Son Deneme:</span>
            <span class="hl-value">${sortedData[sortedData.length - 1].exam_date}</span>
          </div>
        </div>
      </div>
    `;
  }

  // ---------- Alt Ders Dağılımı (Stacked Bar) ----------
  let breakdownChart = null;

  function renderBreakdown() {
    const panel = document.getElementById('analysisBreakdown');

    // Bu filtrede composite parent kayıt var mı kontrol et (scope Genel veya Alan, breakdown'lı)
    const parentRecords = FILTERED_RAW.filter(r => r.scope === 'Genel' || r.scope === 'Alan');
    if (parentRecords.length === 0) {
      panel.innerHTML = `<div class="analysis-card">
        <p class="empty-msg">Alt ders dağılımı için composite bir deneme filtrelemeniz lazım.
        Örn: <strong>Sınav Türü = AYT, Kapsam = Alan, Ders = Fen Bilimleri</strong> seçerseniz,
        her AYT Fen denemesi için Fizik/Kimya/Biyoloji alt dersleri stacked bar olarak gösterilir.</p>
      </div>`;
      return;
    }

    // Her parent için alt ders kayıtlarını (parent_id bazlı) topla.
    // Aynı gün birden fazla composite varsa her biri ayrı kayıt olur (toplama).
    const stackedByDate = {};
    const subjectSet = new Set();

    for (const parent of parentRecords) {
      const subs = getChildrenForParent(parent);
      if (!stackedByDate[parent.exam_date]) stackedByDate[parent.exam_date] = {};
      for (const sub of subs) {
        if (!stackedByDate[parent.exam_date][sub.subject]) {
          stackedByDate[parent.exam_date][sub.subject] = { total: 0, count: 0 };
        }
        stackedByDate[parent.exam_date][sub.subject].total += sub.net;
        stackedByDate[parent.exam_date][sub.subject].count += 1;
        subjectSet.add(sub.subject);
      }
    }

    const dates = Object.keys(stackedByDate).sort();
    const subjects = [...subjectSet];

    if (subjects.length === 0) {
      panel.innerHTML = `<div class="analysis-card">
        <p class="empty-msg">Bu composite denemelerde alt ders kaydı bulunamadı. (Breakdown ile kaydedilmiş olmalı.)</p>
      </div>`;
      return;
    }

    const datasets = subjects.map((subj, idx) => ({
      label: subj,
      data: dates.map(date => {
        const entry = stackedByDate[date] && stackedByDate[date][subj];
        if (!entry) return 0;
        // Aynı gün aynı ders birden fazla parent'ta varsa ortalama al
        return parseFloat((entry.total / entry.count).toFixed(2));
      }),
      backgroundColor: getColor(subj, idx),
      borderWidth: 1,
      borderColor: 'rgba(0,0,0,0.1)'
    }));

    panel.innerHTML = `
      <div class="analysis-card">
        <h4>📉 Alt Ders Dağılımı — ${CURRENT_FILTER.subject || 'Tüm Composite'}</h4>
        <p class="section-desc">Her denemenin altında yatan ders katkıları. Toplam net = alt derslerin netlerinin toplamı.</p>
        <div class="chart-container" style="height:350px">
          <canvas id="breakdownChart"></canvas>
        </div>
        <div class="breakdown-legend-info">
          <p>ℹ Her çubuk bir deneme tarihini temsil eder. Renkli segmentler o tarihteki alt derslerin net katkılarıdır.
          Bar yüksekliği = toplam net. Hangi ders daha büyük = o derse daha iyi hakim.</p>
        </div>
      </div>
    `;

    if (breakdownChart) breakdownChart.destroy();
    const ctxB = document.getElementById('breakdownChart').getContext('2d');
    breakdownChart = new Chart(ctxB, {
      type: 'bar',
      data: { labels: dates, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              footer: function(items) {
                const total = items.reduce((s, it) => s + it.parsed.y, 0);
                return 'Toplam Net: ' + total.toFixed(2);
              }
            }
          }
        },
        scales: {
          x: { stacked: true, title: { display: true, text: 'Tarih' } },
          y: { stacked: true, beginAtZero: true, title: { display: true, text: 'Net' } }
        }
      }
    });
  }

  // ---------- Buton toggle davranışı ----------
  document.querySelectorAll('.analysis-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const target = this.dataset.target;
      const panel = document.getElementById('analysis' + target.charAt(0).toUpperCase() + target.slice(1));
      const isOpen = !panel.classList.contains('hidden');

      // Tüm panelleri kapat
      document.querySelectorAll('.analysis-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.analysis-btn').forEach(b => b.classList.remove('active'));

      if (!isOpen) {
        panel.classList.remove('hidden');
        this.classList.add('active');
        if (target === 'prediction') renderPrediction();
        else if (target === 'stats') renderStats();
        else if (target === 'breakdown') renderBreakdown();
      }
    });
  });
<% } %>
</script>

<%- include('partials/footer') %>
